rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Pillar 0)
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helper
    function isSignedIn() {
      return request.auth != null;
    }

    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    
    // Game history - users can only see and write their own
    match /game_history/{docId} {
      allow read, write: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }
    
    // Player collection - users can only see and write their own card data
    match /player_collection/{docId} {
      allow read, write: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }

    // Saved teams - users can only see and write their own custom squads
    match /saved_teams/{docId} {
      allow read, write: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }

    // Career saves - users can only see and write their own career tracks
    match /career_saves/{docId} {
      allow read, write: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }
  }
}
